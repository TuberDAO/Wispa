@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  /* Core colors from screenshots */
  --bg-dark: #000814;
  --bg-navy: #0a1628;
  --bg-teal: #0d3d4f;
  
  /* Accent colors */
  --cyan-bright: #00d9ff;
  --cyan-glow: #00ffff;
  --magenta: #ff00ff;
  --purple: #9d4edd;
  --green-terminal: #00ff88;
  --yellow-highlight: #ffd60a;
  
  /* Text colors */
  --text-primary: #e8f4f0;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  
  /* Design tokens */
  --radius-sm: 0.5rem;
  --radius-md: 0.75rem;
  --radius-lg: 1rem;
  
  --shadow-glow-cyan: 0 0 30px rgba(0, 217, 255, 0.4);
  --shadow-glow-magenta: 0 0 30px rgba(255, 0, 255, 0.4);
  --shadow-glow-green: 0 0 30px rgba(0, 255, 136, 0.4);
  
  --spacing-section: 8rem;
  --spacing-content: 4rem;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  color: var(--text-primary);
  background: var(--bg-dark);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen',
    'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue',
    sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
}

/* Gradient background with depth */
.gradient-background {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
  background: linear-gradient(
    135deg,
    var(--bg-teal) 0%,
    var(--bg-navy) 40%,
    var(--bg-dark) 70%,
    #000000 100%
  );
}

/* Subtle grid overlay */
.grid-background {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
  background-image: 
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 39px,
      rgba(0, 255, 136, 0.04) 39px,
      rgba(0, 255, 136, 0.04) 40px
    ),
    repeating-linear-gradient(
      90deg,
      transparent,
      transparent 39px,
      rgba(0, 255, 136, 0.04) 39px,
      rgba(0, 255, 136, 0.04) 40px
    );
}

/* Scan line effect for cyberpunk feel */
.scan-lines {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  pointer-events: none;
  background: repeating-linear-gradient(
    0deg,
    rgba(0, 255, 136, 0.03) 0px,
    transparent 1px,
    transparent 2px,
    rgba(0, 255, 136, 0.03) 3px
  );
  animation: scan 8s linear infinite;
}

@keyframes scan {
  0% { transform: translateY(0); }
  100% { transform: translateY(10px); }
}

/* Gradient text utilities */
.gradient-text-cyan {
  background: linear-gradient(
    135deg,
    var(--cyan-bright) 0%,
    var(--cyan-glow) 50%,
    var(--purple) 100%
  );
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.gradient-text-magenta {
  background: linear-gradient(
    90deg,
    var(--magenta) 0%,
    var(--purple) 100%
  );
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Terminal text styling */
.terminal-text {
  font-family: 'Courier New', 'Consolas', monospace;
  letter-spacing: 0.05em;
  color: var(--green-terminal);
  text-shadow: 0 0 10px rgba(0, 255, 136, 0.5);
}

.terminal-bracket {
  font-family: 'Courier New', 'Consolas', monospace;
  color: var(--text-muted);
  font-weight: 400;
}

/* Glow effects */
@layer utilities {
  .text-glow-cyan {
    text-shadow: 0 0 20px rgba(0, 217, 255, 0.6),
                 0 0 40px rgba(0, 217, 255, 0.4);
  }
  
  .text-glow-magenta {
    text-shadow: 0 0 20px rgba(255, 0, 255, 0.6),
                 0 0 40px rgba(255, 0, 255, 0.4);
  }
  
  .text-glow-green {
    text-shadow: 0 0 20px rgba(0, 255, 136, 0.6),
                 0 0 40px rgba(0, 255, 136, 0.4);
  }
  
  .text-pop-accent {
    text-shadow: -1px -1px 0 #000,
                 1px -1px 0 #000,
                 -1px 1px 0 #000,
                 1px 1px 0 #000,
                 0 0 2px rgba(0, 0, 0, 0.9);
  }
  
  .cyber-border-cyan {
    border: 1px solid rgba(0, 217, 255, 0.4);
    box-shadow: 0 0 20px rgba(0, 217, 255, 0.15),
                inset 0 0 20px rgba(0, 217, 255, 0.05);
  }
  
  .cyber-border-magenta {
    border: 1px solid rgba(255, 0, 255, 0.4);
    box-shadow: 0 0 20px rgba(255, 0, 255, 0.15),
                inset 0 0 20px rgba(255, 0, 255, 0.05);
  }

  .box-glow-cyan {
    box-shadow: 0 0 40px rgba(0, 217, 255, 0.3);
  }
  
  .box-glow-magenta {
    box-shadow: 0 0 40px rgba(255, 0, 255, 0.3);
  }
}

/* Animations */
@keyframes pulse-glow {
  0%, 100% { 
    box-shadow: 0 0 20px rgba(0, 217, 255, 0.4);
  }
  50% { 
    box-shadow: 0 0 40px rgba(0, 217, 255, 0.7);
  }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

@keyframes shimmer {
  0% { background-position: -200% center; }
  100% { background-position: 200% center; }
}

/* Smooth transitions with reduced motion support */
@media (prefers-reduced-motion: no-preference) {
  .animate-pulse-glow {
    animation: pulse-glow 3s ease-in-out infinite;
  }
  
  .animate-float {
    animation: float 4s ease-in-out infinite;
  }
  
  .animate-shimmer {
    animation: shimmer 3s linear infinite;
    background-size: 200% 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .scan-lines {
    animation: none;
  }
  
  .animate-pulse-glow,
  .animate-float,
  .animate-shimmer {
    animation: none;
  }
}

/* Focus states for accessibility */
button:focus-visible,
a:focus-visible,
input:focus-visible {
  outline: 2px solid var(--cyan-bright);
  outline-offset: 4px;
}

/* Custom scrollbar */
::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-track {
  background: var(--bg-navy);
}

::-webkit-scrollbar-thumb {
  background: var(--cyan-bright);
  border-radius: 5px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--cyan-glow);
}

